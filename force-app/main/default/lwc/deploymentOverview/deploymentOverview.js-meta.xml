<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>DeploymentLens</masterLabel>
    <description>Recent deployments with component-level drill-down.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="defaultRecordLimit"
                      label="Default number of deployments"
                      type="String"
                      datasource="5,10,20"
                      default="10"
                      description="How many recent deployments to show on load."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
